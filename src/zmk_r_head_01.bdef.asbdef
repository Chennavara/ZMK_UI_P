managed implementation in class zbp_mk_r_head_01 unique;
strict ( 2 );
with draft;


define behavior for ZMK_R_HEAD_01 alias HEAD
persistent table zmk_head_01
draft table ZMK_R_HEAD_01_D
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LastChangedAt
{
  create ( authorization : global );
  update;
  delete;

  field ( numbering : managed ) HeadId;
  field ( readonly ) HeadId;

  field ( readonly ) LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

draft action Resume;
draft action Edit;
draft action Discard;
draft action Activate;
draft determine action Prepare;




  association _ITEM { create; with draft;}

  mapping for zmk_head_01
    {
      HeadId             = head_id;
      Name               = name;
      Description        = description;
      Price              = price;
      StatusCode         = status_code;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }




}

define behavior for ZMK_R_ITEM_01 alias ITEM
persistent table zmk_item_01
draft table zmk_item_01_d
lock dependent by _head
authorization dependent by _head
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) HeadId, ItemId;
  field ( numbering : managed )  ItemId;
  association _head{ with draft; }


  mapping for zmk_item_01
    {
      HeadId   = head_id;
      ItemId   = item_id;
      Material = material;
      Matdes   = matdes;
      Qty      = qty;
      Batch    = batch;
    }


}