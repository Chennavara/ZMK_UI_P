projection;
strict ( 2 );
use draft;

define behavior for ZMK_c_HEAD_01 alias HEAD
{
  use create;
  use update;
  use delete;

use action Resume;
use action Edit;
use action Discard;
use action Activate;
use action Prepare;

  use association _item { create; with draft; }
}

define behavior for ZMK_C_ITEM_01 alias ITEM
{
  use update;
  use delete;

  use association _head {with draft; }
}